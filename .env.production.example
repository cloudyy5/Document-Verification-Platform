# Copy to .env.production on the server and fill keys there; never commit secrets.
APP_URL=https://dvp.ilkomith.cloud
AUTH_FLOW_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DOCUMENT_ENVIRONMENT=production
DOCUMENT_MAX_FILE_BYTES=10485760
# Compose supplies CLAMAV_HOST=clamav and CLAMAV_PORT=3310 on the private network.
CLAMAV_TIMEOUT_MS=30000
# Public operator/support contact shown on the policy page, when configured.
SERVICE_OPERATOR_NAME=KPILKOMITH
SERVICE_SUPPORT_EMAIL=kp.ilkomith@gmail.com
DOCKER_BIND_ADDRESS=127.0.0.1
DOCKER_PORT=3000
