# Run npm run auth:setup to create .env.local and a server-only flow secret.
# Never commit .env.local or send its values to chat.
# Docker: docker compose --env-file .env.local up -d --build
# NEXT_PUBLIC_* values require an image rebuild when changed; secrets are runtime-only.
APP_URL=http://127.0.0.1:3000
AUTH_FLOW_SECRET=

# Public configuration: project URL and publishable key from Supabase.
# Legacy anon keys are accepted for local compatibility; never use service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only privileged key. Never add a NEXT_PUBLIC_ prefix.
# Required for persistent auth rate limits and one-time recovery grants.
SUPABASE_SECRET_KEY=

# Owner-approved Phase 3 development settings. Raising the approved maximum
# or opening public production requires a separate policy/security review.
DOCUMENT_ENVIRONMENT=development
DOCUMENT_MAX_FILE_BYTES=10485760

# Verification HMAC, retention, malware provider and production policy deferred.

# Optional Docker host binding (not the application's canonical origin):
# DOCKER_BIND_ADDRESS=127.0.0.1
# DOCKER_PORT=3000
