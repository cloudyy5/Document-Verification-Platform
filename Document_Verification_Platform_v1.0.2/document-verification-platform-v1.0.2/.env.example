# Public app configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret key. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Verification code derivation. Use a random secret of at least 32 bytes.
VERIFICATION_CODE_SECRET=
VERIFICATION_CODE_KEY_VERSION=1

# Upload policy. Proposed initial value is 20 MiB; owner approval pending.
MAX_PDF_SIZE_BYTES=20971520
ALLOW_ENCRYPTED_PDF=false

# Policy version recorded with each submission.
CURRENT_DOCUMENT_POLICY_VERSION=1.0

# Optional distributed rate limiter for production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional email provider settings; leave unset until provider is selected.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=

# Runtime
NODE_ENV=development
