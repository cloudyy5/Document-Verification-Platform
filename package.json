{
  "name": "document-verification-platform",
  "version": "0.8.3",
  "private": true,
  "type": "module",
  "description": "Document Verification Platform — private documents and internal consent invitations",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "postinstall": "node scripts/prepare-pdfjs.mjs",
    "predev": "node scripts/prepare-pdfjs.mjs",
    "prebuild": "node scripts/prepare-pdfjs.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pdf:signing": "node scripts/test-signing-pdf-local.mjs",
    "test:pdf:movable": "node scripts/test-movable-qr-pdf.mjs",
    "test:e2e": "playwright test",
    "test:ui:qr": "node scripts/prepare-pdfjs.mjs && playwright test --config playwright.qr-editor.config.ts",
    "test:ui:operations": "playwright test --config playwright.operations-ui.config.ts",
    "test:e2e:workspace": "node --env-file-if-exists=.env.local scripts/test-workspace-browser.mjs",
    "test:cloud:workspace": "node --env-file-if-exists=.env.local scripts/test-workspace-cloud.mjs",
    "test:cloud:signing": "node --env-file-if-exists=.env.local scripts/test-signing-cloud.mjs",
    "test:cloud:signing:r3": "node --env-file-if-exists=.env.local scripts/test-signing-r3-cloud.mjs",
    "test:cloud:signing:r3b": "node --env-file-if-exists=.env.local scripts/test-signing-r3b-cloud.mjs",
    "test:e2e:ui": "playwright test --ui",
    "test:db": "node scripts/test-database.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "auth:setup": "node scripts/setup-auth.mjs",
    "supabase:check": "node --env-file-if-exists=.env.local scripts/check-supabase.mjs",
    "db:types": "node scripts/test-database.mjs --generate-types",
    "supabase:status": "supabase status",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "format": "prettier --write src tests scripts supabase/templates *.ts *.mjs *.json *.yml README.md docs .github",
    "format:check": "prettier --check src tests scripts supabase/templates *.ts *.mjs *.json *.yml README.md docs .github"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "clsx": "2.1.1",
    "geist": "1.9.0",
    "lucide-react": "1.66.0",
    "next": "16.4.3",
    "next-themes": "0.4.6",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@napi-rs/canvas": "1.1.0",
    "@next/eslint-plugin-next": "16.4.3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsqr": "1.4.0",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "supabase": "2.122.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
